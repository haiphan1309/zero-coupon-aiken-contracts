use daken/time.{
  get_epoch_config_preview, get_milliseconds_of_day,
  get_slot_config_network_preview,
}

const epoch_cfg = get_epoch_config_preview()

const slot_cfg = get_slot_config_network_preview()

pub const year_to_epoch = epoch_cfg.year_to_epoch

pub const epoch_boundary = epoch_cfg.epoch_boundary

pub const epoch_boundary_as_epoch = epoch_cfg.epoch_boundary_as_epoch

pub const epoch_length = epoch_cfg.epoch_length

pub const epoch_length_base = epoch_cfg.epoch_length_base

pub const year_in_ms = 365 * get_milliseconds_of_day(epoch_cfg)

pub const zero_time = slot_cfg.zero_time

pub const zero_slot = slot_cfg.zero_slot

pub const slot_length = slot_cfg.slot_length

pub const ttl = 6 * 60

pub const prefix_ga_treasury_sc: ByteArray =
  #""

